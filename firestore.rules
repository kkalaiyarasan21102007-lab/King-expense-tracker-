rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Every document lives under /users/{uid}/... .
    // A signed-in user may only read or write documents nested under
    // their OWN uid. Since this app has no public registration and you
    // create exactly one admin account yourself in the Firebase console,
    // this effectively means: only your single admin login can ever
    // read or write this data, from any device, once signed in.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
